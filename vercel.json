{
  "services": {
    "backend": {
      "root": "backend/",
      "entrypoint": "app.main:app"
    },
    "participant": {
      "root": "apps/participant/",
      "framework": "vite"
    },
    "admin": {
      "root": "apps/admin/",
      "framework": "vite"
    },
    "big-screen": {
      "root": "apps/big-screen/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/ws/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/big-screen/(.*)",
      "destination": {
        "service": "big-screen"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "participant"
      }
    }
  ]
}
