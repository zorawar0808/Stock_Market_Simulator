# PostgreSQL connection (async driver, used by the running app)
DATABASE_URL=postgresql+asyncpg://esummit:esummit@localhost:5432/esummit

# PostgreSQL connection (sync driver, used only by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://esummit:esummit@localhost:5432/esummit

# Auth
SECRET_KEY=change-this-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# Game defaults (organizer-configurable overrides can live in the market_state
# table / admin console once built; these are the bootstrap defaults)
DEFAULT_STARTING_CAPITAL=10000
DEFAULT_MAX_TEAM_MEMBERS=3
PRICE_TICK_INTERVAL_SECONDS=4

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
